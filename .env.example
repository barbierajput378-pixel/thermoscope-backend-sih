# NASA FIRMS - get a free map key at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bounding box for the region you're covering (min_lon,min_lat,max_lon,max_lat)
REGION_BBOX=85.5,22.0,87.0,23.5

# Optional ML classifier (off by default; train with pipeline/ml/train_model.py)
USE_ML_CLASSIFIER=false

# Optional daily pre-fire risk scoring
RISK_WEATHER_API_URL=
RISK_WEATHER_API_KEY=
RISK_HISTORY_DAYS=90

# Optional alerts (off by default). Without email settings alerts are logged as DRY RUN.
ENABLE_ALERTS=false
ALERT_CONFIDENCE_THRESHOLD=0.75
ALERT_RISK_THRESHOLD=80
ALERT_COOLDOWN_HOURS=24
ALERT_EMAIL_PROVIDER=
ALERT_EMAIL_API_KEY=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_EMAIL_TO_PCB=
ALERT_EMAIL_TO_FIRE_SERVICES=
ALERT_EMAIL_TO_MINE_SAFETY=
ALERT_EMAIL_TO_FOREST_DEPT=
ALERT_EMAIL_TO_AGRI_OFFICE=
ALERT_EMAIL_TO_MONITORING_DESK=
